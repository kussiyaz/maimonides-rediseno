---
import '../styles/global.css';
import '../styles/pages.css';

export interface Props {
  title: string;
  pageTitle: string;
  activeNav?: string;
  hideBackButton?: boolean;
  sidebarActive?: string;
  studentName?: string;
  studentAvatar?: string;
  studentCareer?: string;
  studentId?: string;
}

const { title, pageTitle, activeNav = 'inicio', hideBackButton = false, sidebarActive = '', studentName = 'Yazmin Kussi', studentAvatar = 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&h=80&fit=crop&crop=face', studentCareer = 'Tecnología Multimedial', studentId = '1' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#003366">
  <title>{title} | Campus Virtual UMAI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .menu-btn { position: relative; z-index: 10; }
    .back-btn { position: relative; z-index: 10; }
  </style>
</head>
<body>
  <div class="app-container">
    <header class="app-header">
      <div class="header-left">
        <button class="menu-btn" id="menuToggle" aria-label="Abrir menú">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        {!hideBackButton && (
          <button class="back-btn" id="backBtn" aria-label="Volver">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>
        )}
        <a href="/" class="header-logo-text">
          <img src="https://www.maimonides.edu/wp-content/uploads/2022/02/logos_300x55_original-400x74.png" alt="UMAI">
        </a>
      </div>
      <div class="header-center">
        <h1 class="page-title">{pageTitle}</h1>
      </div>
      <div class="header-right">
        <div class="notification-container">
          <button class="icon-btn notification-btn" id="notificationBtn" aria-label="Notificaciones">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <span class="notification-badge">2</span>
          </button>
          <div class="notification-dropdown" id="notificationDropdown">
            <div class="notification-header"><span>Notificaciones</span></div>
            <div class="notification-item unread">
              <div class="notification-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <div class="notification-content">
                <p class="notification-text">Nuevo material disponible en Programación Multimedial II</p>
                <span class="notification-time">Hace 10 min</span>
              </div>
            </div>
            <div class="notification-item unread">
              <div class="notification-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <div class="notification-content">
                <p class="notification-text">Recordatorio: Parcial de Prog. MM II el viernes 12</p>
                <span class="notification-time">Hace 1 hora</span>
              </div>
            </div>
            <div class="notification-item">
              <div class="notification-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <div class="notification-content">
                <p class="notification-text">Mg. Damián Pereyra te envió un mensaje</p>
                <span class="notification-time">Ayer</span>
              </div>
            </div>
          </div>
        </div>
        <a href={`/perfil/${studentId}`} class="icon-btn profile-btn" aria-label="Mi perfil">
          <img src={studentAvatar} alt={studentName} class="avatar-small">
        </a>
      </div>
    </header>

    <div class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <img src={studentAvatar} alt={studentName} class="avatar-large">
        <div class="sidebar-user-info">
          <span class="sidebar-user-name">{studentName}</span>
          <span class="sidebar-user-career">{studentCareer}</span>
        </div>
        <button class="sidebar-close" id="sidebarClose" aria-label="Cerrar menú">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <nav class="sidebar-nav">
        <a href="/" class="sidebar-nav-item {sidebarActive === 'inicio' ? 'active' : ''}">Inicio</a>
        <a href={`/perfil/${studentId}`} class="sidebar-nav-item {sidebarActive === 'perfil' ? 'active' : ''}">Mi Perfil</a>
        <a href="/materias" class="sidebar-nav-item {sidebarActive === 'materias' ? 'active' : ''}">Materias</a>
        <a href="/mensajes" class="sidebar-nav-item {sidebarActive === 'mensajes' ? 'active' : ''}">Mensajes <span class="nav-badge">3</span></a>
        <a href="/situacion" class="sidebar-nav-item {sidebarActive === 'situacion' ? 'active' : ''}">Situación Académica</a>
        <a href="/administracion" class="sidebar-nav-item {sidebarActive === 'administracion' ? 'active' : ''}">Administración</a>
        <a href="/calendario" class="sidebar-nav-item {sidebarActive === 'calendario' ? 'active' : ''}">Calendario Académico</a>
        <a href="/biblioteca" class="sidebar-nav-item {sidebarActive === 'biblioteca' ? 'active' : ''}">Biblioteca</a>
        <a href="/certificados" class="sidebar-nav-item {sidebarActive === 'certificados' ? 'active' : ''}">Certificados</a>
        <a href="/examenes" class="sidebar-nav-item {sidebarActive === 'examenes' ? 'active' : ''}">Exámenes Finales</a>
        <a href="https://discord.gg/dvx52uaV" target="_blank" rel="noopener noreferrer" class="sidebar-nav-item sidebar-nav-item-discord">
          <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
          <span>Discord</span>
        </a>
      </nav>
      <div class="sidebar-footer">
        <a href="/configuracion" class="sidebar-nav-item">Configuración</a>
        <a href="/login" class="sidebar-nav-item sidebar-nav-item-danger">Cerrar Sesión</a>
      </div>
    </div>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <main class="main-content">
      <slot />
    </main>

    <nav class="bottom-nav" role="navigation">
      <a href="/" class="bottom-nav-item {activeNav === 'inicio' ? 'active' : ''}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Inicio</span>
      </a>
      <a href="/materias" class="bottom-nav-item {activeNav === 'materias' ? 'active' : ''}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        <span>Materias</span>
      </a>
      <a href="/calendario" class="bottom-nav-item {activeNav === 'calendario' ? 'active' : ''}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>Calendario</span>
      </a>
      <a href="/mensajes" class="bottom-nav-item {activeNav === 'mensajes' ? 'active' : ''}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <span>Mensajes</span>
      </a>
      <a href={`/perfil/${studentId}`} class="bottom-nav-item {activeNav === 'perfil' ? 'active' : ''}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span>Perfil</span>
      </a>
    </nav>
  </div>

  <script is:inline src="/main.js"></script>
  <script is:inline>
    (function() {
      var data = sessionStorage.getItem('usuario');
      if (data) {
        try {
          var user = JSON.parse(data);
          var imgs = document.querySelectorAll('.profile-btn img, .sidebar-header .avatar-large');
          for (var i = 0; i < imgs.length; i++) {
            imgs[i].src = user.foto_url || imgs[i].src;
          }
          var nameEl = document.querySelector('.sidebar-user-name');
          if (nameEl) nameEl.textContent = user.nombre_completo || nameEl.textContent;
          var perfilLink = document.querySelector('.profile-btn');
          if (perfilLink && user.usuario) {
            perfilLink.href = '/perfil/' + user.usuario;
          }
        } catch(e) {}
      }
    })();
  </script>
</body>
</html>
