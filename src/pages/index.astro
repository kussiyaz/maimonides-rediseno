---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard" pageTitle="Licenciatura en Tecnología Multimedial" activeNav="inicio" sidebarActive="inicio">
  <script is:inline>
    (function(){
      if (!sessionStorage.getItem('usuario')) {
        window.location.href = '/login';
      }
    })();
  </script>
  <section class="welcome-section">
    <div class="welcome-card">
      <div class="welcome-content">
        <div class="welcome-text">
          <h2 class="welcome-title" id="welcomeTitle">¡Hola!</h2>
          <p class="welcome-subtitle">Tecnología Multimedial · 3er Año</p>
        </div>
        <div class="welcome-stats">
          <div class="stat-item">
            <span class="stat-value">72%</span>
            <span class="stat-label">Cursada</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">2</span>
            <span class="stat-label">Parciales</span>
          </div>
        </div>
      </div>
      <div class="welcome-icon">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <polygon points="12 2 2 7 12 12 22 7 12 2"/>
          <polyline points="2 17 12 22 22 17"/>
          <polyline points="2 12 12 17 22 12"/>
        </svg>
      </div>
    </div>
  </section>

  <section class="search-section">
    <div class="search-container">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="search" class="search-input" placeholder="Buscar materia, recurso..." aria-label="Buscar">
    </div>
  </section>

  <section class="today-class-section" id="todayClassSection">
    <h3 class="section-subtitle">Hoy · <span id="todayDate"></span></h3>
    <div class="today-class-card" id="todayClassCard">
      <div class="today-class-content">
        <div class="today-class-time">
          <span class="today-class-hour" id="todayClassHour"></span>
          <span class="today-class-schedule" id="todayClassSchedule"></span>
        </div>
        <div class="today-class-info">
          <h4 class="today-class-name" id="todayClassName"></h4>
          <p class="today-class-teacher" id="todayClassTeacher"></p>
          <p class="today-class-location" id="todayClassLocation"></p>
        </div>
      </div>
      <div class="today-class-assignment" id="todayClassAssignment" style="display: none;">
        <div class="assignment-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <span id="todayAssignmentTitle"></span>
        </div>
        <span class="assignment-due" id="todayAssignmentDue"></span>
      </div>
    </div>
    <div class="no-class-card" id="noClassCard" style="display: none;">
      <div class="no-class-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
      </div>
      <p class="no-class-text">No tienes clases programadas para hoy</p>
    </div>
  </section>

  <section class="courses-section">
    <div class="section-header">
      <h2 class="section-title">
        Cursando
        <span class="course-count" id="courseCount">0 materias</span>
      </h2>
      <a href="/materias" class="see-all-link">Ver todas</a>
    </div>
    <div class="courses-grid" id="coursesGrid"></div>
  </section>

  <section class="upcoming-section">
    <div class="section-header">
      <h2 class="section-title">
        Próximos Exámenes
        <span class="course-count warning">2</span>
      </h2>
      <a href="/calendario" class="see-all-link">Ver calendario</a>
    </div>

    <div class="exams-list">
      <article class="exam-card">
        <div class="exam-date">
          <span class="exam-day">12</span>
          <span class="exam-month">Abr</span>
        </div>
        <div class="exam-info">
          <h3 class="exam-title">Parcial: Programación Multimedial II</h3>
          <p class="exam-details">Aula 402 - Edificio Principal</p>
        </div>
        <div class="exam-status exam-status-soon">4 días</div>
      </article>

      <article class="exam-card">
        <div class="exam-date">
          <span class="exam-day">18</span>
          <span class="exam-month">Abr</span>
        </div>
        <div class="exam-info">
          <h3 class="exam-title">Parcial: Producción Audiovisual</h3>
          <p class="exam-details">Lab. de Video - Piso 3</p>
        </div>
        <div class="exam-status exam-status-warning">10 días</div>
      </article>
    </div>
  </section>

  <section class="pending-section">
    <div class="section-header">
      <h2 class="section-title">Pendientes</h2>
    </div>

    <div class="pending-list">
      <article class="pending-card">
        <div class="pending-icon pending-icon-urgent">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div class="pending-content">
          <h3 class="pending-title">TP Final: Arte Digital I</h3>
          <p class="pending-meta">Vence en 2 días</p>
        </div>
        <a href="/materias/arte-digital-i" class="btn btn-sm btn-primary">Entregar</a>
      </article>

      <article class="pending-card">
        <div class="pending-icon pending-icon-warning">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
        </div>
        <div class="pending-content">
          <h3 class="pending-title">Cuestionario: Diseño Aplicado</h3>
          <p class="pending-meta">Vence en 5 días</p>
        </div>
        <a href="/materias/diseno-aplicado" class="btn btn-sm btn-secondary">Resolver</a>
      </article>
    </div>
  </section>

  <section class="announcements-section">
    <div class="section-header">
      <h2 class="section-title">Anuncios</h2>
    </div>

    <div class="announcements-list">
      <article class="announcement-card announcement-urgent">
        <div class="announcement-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>
        <div class="announcement-content">
          <h3 class="announcement-title">Aula invertida: Prog. Multimedial II</h3>
          <p class="announcement-text">Revisá el video sobre React Native antes del parcial del viernes.</p>
          <time class="announcement-time">Hoy, 09:30</time>
        </div>
      </article>

      <article class="announcement-card">
        <div class="announcement-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div class="announcement-content">
          <h3 class="announcement-title">Nuevo material: Arte Digital I</h3>
          <p class="announcement-text">Subí el taller de Illustrator para el TP final.</p>
          <time class="announcement-time">Ayer</time>
        </div>
      </article>
    </div>
  </section>

  <script is:inline>
    (function(){
      var data = sessionStorage.getItem('usuario');
      if (!data) return;
      try {
        var user = JSON.parse(data);
        var name = user.nombre_corto || (user.nombre_completo ? user.nombre_completo.split(' ')[0] : null);
        var titleEl = document.getElementById('welcomeTitle');
        if (titleEl && name) {
          titleEl.textContent = '\u00a1Hola, ' + name + '!';
        }
        var grid = document.getElementById('coursesGrid');
        var countEl = document.getElementById('courseCount');
        if (!grid || !user.materias || !user.materias.length) return;
        if (countEl) countEl.textContent = user.materias.length + ' materias';
        for (var i = 0; i < user.materias.length; i++) {
          var m = user.materias[i];
          var slug = m.nombre.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/, '');
          var badgeClass = 'course-badge-active';
          var badgeText = 'Cursando';
          if (m.estado === 'Aprobado') { badgeClass = 'course-badge-completed'; badgeText = 'Aprobado'; }
          else if (m.estado === 'Recuperatorio') { badgeClass = 'course-badge-upcoming'; badgeText = 'Recuperatorio'; }
          var nota = typeof m.nota === 'number' ? m.nota : 0;
          var pct = nota * 10;
          var card = document.createElement('a');
          card.className = 'course-card' + (i === 0 ? ' course-card-featured' : '');
          card.href = '/materias/' + slug;
          card.innerHTML =
            '<div class="course-header">' +
              '<div class="course-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>' +
              '<span class="course-badge ' + badgeClass + '">' + badgeText + '</span>' +
            '</div>' +
            '<h3 class="course-title">' + m.nombre + '</h3>' +
            '<p class="course-teacher">Nota: ' + nota + '</p>' +
            '<div class="course-progress">' +
              '<div class="progress-info"><span class="progress-label">Rendimiento</span><span class="progress-value">' + pct + '%</span></div>' +
              '<div class="progress-bar"><div class="progress-fill" style="width:' + pct + '%;"></div></div>' +
            '</div>';
          grid.appendChild(card);
        }
      } catch(e) {}
    })();
  </script>

  <section class="studyplan-section">
    <div class="section-header">
      <h2 class="section-title">Plan de Estudios</h2>
      <a href="/situacion" class="see-all-link">Ver avance</a>
    </div>

    <div class="studyplan-container">
      <div class="studyplan-year">
        <div class="studyplan-year-header studyplan-completed">
          <span class="studyplan-year-number">1er Año</span>
          <span class="studyplan-year-status">Completado</span>
        </div>
        <div class="studyplan-materias">
          <span class="studyplan-materia approved">Fundamentos de Diseño</span>
          <span class="studyplan-materia approved">Imagen Digital</span>
          <span class="studyplan-materia approved">Producción Digital I</span>
          <span class="studyplan-materia approved">Programación MM I</span>
          <span class="studyplan-materia approved">Redes y Tecnologías</span>
        </div>
      </div>

      <div class="studyplan-year">
        <div class="studyplan-year-header studyplan-completed">
          <span class="studyplan-year-number">2do Año</span>
          <span class="studyplan-year-status">Completado</span>
        </div>
        <div class="studyplan-materias">
          <span class="studyplan-materia approved">Diseño de Interfaces</span>
          <span class="studyplan-materia approved">Producción Digital II</span>
          <span class="studyplan-materia approved">Técnicas de Animación</span>
          <span class="studyplan-materia approved">Programación MM II</span>
          <span class="studyplan-materia approved">Historia del Arte</span>
        </div>
      </div>

      <div class="studyplan-year">
        <div class="studyplan-year-header studyplan-current">
          <span class="studyplan-year-number">3er Año</span>
          <span class="studyplan-year-status">En Curso</span>
        </div>
        <div class="studyplan-materias">
          <span class="studyplan-materia current">Prog. Multimedial II</span>
          <span class="studyplan-materia current">Diseño Aplicado</span>
          <span class="studyplan-materia current">Producción Audiovisual</span>
          <span class="studyplan-materia current">Arte Digital I</span>
          <span class="studyplan-materia current">Comunicación Social</span>
          <span class="studyplan-materia">Investigación de Mercado</span>
          <span class="studyplan-materia">Marketing Aplicado</span>
        </div>
      </div>

      <div class="studyplan-year">
        <div class="studyplan-year-header studyplan-pending">
          <span class="studyplan-year-number">4to Año</span>
          <span class="studyplan-year-status">Pendiente</span>
        </div>
        <div class="studyplan-materias">
          <span class="studyplan-materia">Prog. Multimedial III</span>
          <span class="studyplan-materia">Diseño Estratégico</span>
          <span class="studyplan-materia">Sistemas Gamificados</span>
          <span class="studyplan-materia">Proyecto Senior II</span>
          <span class="studyplan-materia">Trabajo Final</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
