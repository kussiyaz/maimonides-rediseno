---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Certificados" pageTitle="Certificados" activeNav="materias" sidebarActive="certificados">
  <section class="certificates-section">
    <h3 class="section-subtitle">Certificados Disponibles</h3>
    <div class="certificates-list">
      <div class="certificate-card">
        <div class="certificate-icon certificate-icon-primary">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
        </div>
        <div class="certificate-content">
          <h4 class="certificate-title">Constancia de Alumno Regular</h4>
          <p class="certificate-detail">Válida para: Tramites, Subsidios, Visa</p>
          <span class="certificate-date">Exp: 08/04/2026</span>
        </div>
        <button class="btn btn-sm btn-primary">Descargar</button>
      </div>
      <div class="certificate-card">
        <div class="certificate-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <div class="certificate-content">
          <h4 class="certificate-title">Certificado de Estudios</h4>
          <p class="certificate-detail">Historial completo de materias aprobadas</p>
          <span class="certificate-date">Exp: 08/04/2026</span>
        </div>
        <button class="btn btn-sm btn-primary">Descargar</button>
      </div>
      <div class="certificate-card">
        <div class="certificate-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div class="certificate-content">
          <h4 class="certificate-title">Constancia de Cursada</h4>
          <p class="certificate-detail">Materias que está cursando actualmente</p>
          <span class="certificate-date">Exp: 08/04/2026</span>
        </div>
        <button class="btn btn-sm btn-primary">Descargar</button>
      </div>
    </div>
  </section>

  <section class="requested-section">
    <h3 class="section-subtitle">Solicitudes Recientes</h3>
    <div class="requests-list">
      <div class="request-item">
        <div class="request-content">
          <h4 class="request-title">Título Intermedio: Técnico en Comunicación Interactiva</h4>
          <p class="request-status request-approved">Aprobado - En tramite</p>
        </div>
        <span class="request-date">Mar 2026</span>
      </div>
      <div class="request-item">
        <div class="request-content">
          <h4 class="request-title">Certificado Analítico Parcial</h4>
          <p class="request-status request-completed">Entregado</p>
        </div>
        <span class="request-date">Ene 2026</span>
      </div>
    </div>
  </section>
</BaseLayout>
