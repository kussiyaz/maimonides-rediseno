---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { connectDB, Alumno } from '../../lib/mongodb';

export const prerender = false;

const { id } = Astro.params;

let alumno = null;
let errorMsg = null;

try {
  await connectDB();
  alumno = await Alumno.findOne({ usuario: id });
  if (!alumno) {
    errorMsg = `Alumno "${id}" no encontrado`;
  }
} catch (err) {
  errorMsg = 'Error al conectar con la base de datos';
  console.error('Error en perfil:', err);
}
---

{
  errorMsg ? (
    <BaseLayout title="Error" pageTitle="Mi Perfil" activeNav="perfil" sidebarActive="perfil">
      <section class="profile-header-section">
        <div class="profile-card" style="text-align:center;padding:40px">
          <p style="color:#B93824;font-weight:600">{errorMsg}</p>
          <a href="/" class="login-btn" style="display:inline-block;margin-top:16px;padding:12px 24px;background:#003366;color:white;border-radius:12px;text-decoration:none">Volver al inicio</a>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title={alumno.nombre_completo} pageTitle="Mi Perfil" activeNav="perfil" sidebarActive="perfil" studentName={alumno.nombre_completo} studentAvatar={alumno.foto_url} studentCareer="Tecnología Multimedial" studentId={alumno.usuario}>
      <section class="profile-header-section">
        <div class="profile-card">
          <div class="profile-avatar">
            <img src={alumno.foto_url} alt={alumno.nombre_completo}>
          </div>
          <div class="profile-info">
            <h2 class="profile-name">{alumno.nombre_completo}</h2>
            <p class="profile-email">@{alumno.usuario}</p>
            <span class="profile-badge">Estudiante Activo</span>
          </div>
        </div>
      </section>

      <section class="profile-data-section">
        <h3 class="section-subtitle">Datos Académicos</h3>
        <div class="data-list">
          <div class="data-item">
            <span class="data-label">Usuario</span>
            <span class="data-value">{alumno.usuario}</span>
          </div>
          <div class="data-item">
            <span class="data-label">Nombre completo</span>
            <span class="data-value">{alumno.nombre_completo}</span>
          </div>
          <div class="data-item">
            <span class="data-label">Materias cursando</span>
            <span class="data-value">{alumno.materias.filter(m => m.estado === 'Cursando').length}</span>
          </div>
          <div class="data-item">
            <span class="data-label">Materias aprobadas</span>
            <span class="data-value">{alumno.materias.filter(m => m.estado === 'Aprobado').length}</span>
          </div>
          <div class="data-item">
            <span class="data-label">Total materias</span>
            <span class="data-value">{alumno.materias.length}</span>
          </div>
        </div>
      </section>

      <section class="profile-data-section">
        <h3 class="section-subtitle">Materias</h3>
        <div class="data-list">
          {alumno.materias.map(m => (
            <div class="data-item">
              <span class="data-label">{m.nombre}</span>
              <span class="data-value" style={m.estado === 'Aprobado' ? 'color:#22A67E' : m.estado === 'Recuperatorio' ? 'color:#E68A2E' : ''}>
                {m.estado} {m.nota ? `- ${m.nota}` : ''}
              </span>
            </div>
          ))}
        </div>
      </section>

      <section class="profile-actions-section">
        <a href="/configuracion" class="action-card">
          <div class="action-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
          </div>
          <div class="action-content">
            <span class="action-title">Configuración de Cuenta</span>
            <span class="action-desc">Cambiar contraseña, idioma, notificaciones</span>
          </div>
          <svg class="action-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </section>
    </BaseLayout>
  )
}
