---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Administración" pageTitle="Administración" activeNav="materias" sidebarActive="administracion">
  <section class="treasury-summary">
    <div class="treasury-card treasury-card-alert">
      <div class="treasury-header">
        <span class="treasury-label">Cuota Vencida</span>
        <span class="treasury-badge">Pendiente</span>
      </div>
      <div class="treasury-amount">$45.000</div>
      <p class="treasury-detail">Vencimiento: 05/04/2026</p>
      <button class="btn btn-primary btn-block">Pagar Ahora</button>
    </div>
  </section>

  <section class="treasury-section">
    <h3 class="section-subtitle">Estado de Cuenta</h3>
    <div class="account-summary">
      <div class="account-item">
        <span class="account-label">Total Adeudado</span>
        <span class="account-value account-value-danger">$67.500</span>
      </div>
      <div class="account-item">
        <span class="account-label">Próximo Vencimiento</span>
        <span class="account-value">05/05/2026</span>
      </div>
      <div class="account-item">
        <span class="account-label">Monto Próxima Cuota</span>
        <span class="account-value">$22.500</span>
      </div>
    </div>
  </section>

  <section class="payments-section">
    <h3 class="section-subtitle">Historial de Pagos</h3>
    <div class="payments-list">
      <div class="payment-item">
        <div class="payment-info">
          <span class="payment-desc">Cuota Marzo 2026</span>
          <span class="payment-date">05/03/2026</span>
        </div>
        <div class="payment-status payment-paid">✓ Pagado</div>
        <span class="payment-amount">$22.500</span>
      </div>
      <div class="payment-item">
        <div class="payment-info">
          <span class="payment-desc">Cuota Febrero 2026</span>
          <span class="payment-date">05/02/2026</span>
        </div>
        <div class="payment-status payment-paid">✓ Pagado</div>
        <span class="payment-amount">$22.500</span>
      </div>
      <div class="payment-item">
        <div class="payment-info">
          <span class="payment-desc">Cuota Enero 2026</span>
          <span class="payment-date">05/01/2026</span>
        </div>
        <div class="payment-status payment-paid">✓ Pagado</div>
        <span class="payment-amount">$20.000</span>
      </div>
      <div class="payment-item">
        <div class="payment-info">
          <span class="payment-desc">Cuota Diciembre 2025</span>
          <span class="payment-date">05/12/2025</span>
        </div>
        <div class="payment-status payment-paid">✓ Pagado</div>
        <span class="payment-amount">$20.000</span>
      </div>
    </div>
  </section>

  <section class="methods-section">
    <h3 class="section-subtitle">Medios de Pago</h3>
    <div class="payment-methods">
      <div class="method-card">
        <div class="method-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <span class="method-name">Tarjeta de Crédito</span>
      </div>
      <div class="method-card">
        <div class="method-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <span class="method-name">Tarjeta de Débito</span>
      </div>
      <div class="method-card">
        <div class="method-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
        </div>
        <span class="method-name">Rapipago</span>
      </div>
      <div class="method-card">
        <div class="method-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
        </div>
        <span class="method-name">Pago Fácil</span>
      </div>
      <div class="method-card">
        <div class="method-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        </div>
        <span class="method-name">Transferencia</span>
      </div>
    </div>
  </section>
</BaseLayout>
