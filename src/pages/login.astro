---
import '../styles/global.css';
import '../styles/pages.css';

const title = 'Iniciar Sesión';
const pageTitle = '';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#003366">
    <title>{title} | Campus Virtual UMAI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .login-container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: linear-gradient(135deg, #003366 0%, #004080 100%);
            position: relative;
            overflow: hidden;
        }

        .login-container::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 600px 400px at 10% 20%, rgba(0, 102, 204, 0.15) 0%, transparent 100%),
                radial-gradient(ellipse 500px 300px at 90% 80%, rgba(0, 212, 170, 0.08) 0%, transparent 100%);
            pointer-events: none;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #ffffff;
            border-radius: 20px;
            padding: 40px 32px;
            box-shadow: 0 20px 60px rgba(0, 51, 102, 0.25), 0 8px 20px rgba(0, 51, 102, 0.1);
            position: relative;
            z-index: 1;
        }

        .login-logo {
            display: block;
            width: 160px;
            margin: 0 auto 32px;
        }

        .login-title {
            text-align: center;
            font-size: 1.5rem;
            font-weight: 700;
            color: #003366;
            margin-bottom: 28px;
            letter-spacing: -0.02em;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #506477;
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            height: 50px;
            padding: 0 16px;
            font-family: inherit;
            font-size: 0.9375rem;
            color: #003366;
            background: #F5F7FA;
            border: 1.5px solid #DFE3EB;
            border-radius: 12px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-input::placeholder {
            color: #8C9BAA;
        }

        .form-input:focus {
            background: #ffffff;
            border-color: #0066CC;
            box-shadow: 0 0 0 4px rgba(0, 102, 204, 0.1);
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper .form-input {
            padding-right: 48px;
        }

        .toggle-password {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            border-radius: 8px;
            color: #8C9BAA;
            cursor: pointer;
            transition: color 0.2s ease, background 0.2s ease;
        }

        .toggle-password:hover {
            color: #506477;
            background: rgba(0, 0, 0, 0.04);
        }

        .login-error {
            display: none;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            margin-bottom: 20px;
            background: #FFF0EE;
            border: 1px solid #FFC2B3;
            border-radius: 12px;
            color: #B93824;
            font-size: 0.8125rem;
            font-weight: 500;
        }

        .login-error.visible {
            display: flex;
        }

        .login-error svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .form-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
        }

        .form-checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #0066CC;
            cursor: pointer;
        }

        .form-checkbox label {
            font-size: 0.8125rem;
            color: #506477;
            cursor: pointer;
            user-select: none;
        }

        .login-btn {
            width: 100%;
            height: 52px;
            background: #003366;
            color: white;
            font-family: inherit;
            font-size: 0.9375rem;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            letter-spacing: 0.01em;
        }

        .login-btn:hover {
            background: #004080;
            box-shadow: 0 8px 24px rgba(0, 51, 102, 0.25);
            transform: translateY(-1px);
        }

        .login-btn:active {
            transform: translateY(0);
            box-shadow: none;
        }

        .login-links {
            text-align: center;
            margin-top: 24px;
        }

        .login-link {
            color: #0066CC;
            text-decoration: none;
            font-size: 0.8125rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .login-link:hover {
            color: #004C99;
            text-decoration: underline;
        }

        .login-support {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 28px;
            padding: 14px 20px;
            background: #F5F7FA;
            border-radius: 12px;
            color: #506477;
            font-size: 0.8125rem;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .login-support:hover {
            background: #EBEFF5;
        }

        .login-support svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            color: #0066CC;
        }

        .desktop-banner {
            display: none;
        }

        .login-requirements {
            text-align: center;
            margin-top: 24px;
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.6);
            position: relative;
            z-index: 1;
        }

        @media (min-width: 1024px) {
            .login-container {
                flex-direction: row;
                gap: 64px;
            }

            .login-card {
                margin: 0;
            }

            .desktop-banner {
                display: block;
                width: 50%;
                max-width: 520px;
                text-align: center;
                color: white;
                position: relative;
                z-index: 1;
            }

            .desktop-banner svg {
                width: 120px;
                height: 120px;
                margin-bottom: 24px;
                opacity: 0.4;
            }

            .desktop-banner h1 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 12px;
                letter-spacing: -0.03em;
            }

            .desktop-banner p {
                font-size: 1.125rem;
                opacity: 0.85;
                line-height: 1.6;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="desktop-banner">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                <polyline points="2 17 12 22 22 17"/>
                <polyline points="2 12 12 17 22 12"/>
            </svg>
            <h1>Universidad Maimónides</h1>
            <p>Tu campus virtual para una educación de excelencia</p>
        </div>
        <div class="login-card">
            <img src="https://www.maimonides.edu/wp-content/uploads/2022/02/logos_300x55_original-400x74.png" alt="UMAI" class="login-logo">
            <h2 class="login-title">Ingresá a tu cuenta</h2>
            <form id="loginForm">
                <div class="login-error" id="loginError">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span id="loginErrorText"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" for="username">Usuario o Email</label>
                    <input type="text" id="username" class="form-input" placeholder="Tu usuario o email" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="password">Contraseña</label>
                    <div class="input-wrapper">
                        <input type="password" id="password" class="form-input" placeholder="Tu contraseña" required>
                        <button type="button" class="toggle-password" id="togglePassword" aria-label="Mostrar contraseña">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="form-checkbox">
                    <input type="checkbox" id="remember">
                    <label for="remember">Recordarme</label>
                </div>
                <button type="submit" class="login-btn">Ingresar</button>
            </form>
            <div class="login-links">
                <a href="#" class="login-link">¿Olvidaste tu contraseña?</a>
            </div>
            <div class="login-support">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <span>¿Necesitás ayuda? Chateá con soporte</span>
            </div>
        </div>
        <p class="login-requirements">
            Navegadores recomendados: Chrome, Firefox, Edge o Safari (versión actual)
        </p>
    </div>
    <script is:inline>
        var errorEl = document.getElementById('loginError');
        var errorText = document.getElementById('loginErrorText');
        var passwordInput = document.getElementById('password');
        var toggleBtn = document.getElementById('togglePassword');
        function showError(msg) {
            errorText.textContent = msg;
            errorEl.classList.add('visible');
        }
        function hideError() {
            errorEl.classList.remove('visible');
        }
        toggleBtn.addEventListener('click', function() {
            var isPassword = passwordInput.type === 'password';
            passwordInput.type = isPassword ? 'text' : 'password';
            toggleBtn.innerHTML = isPassword
                ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
                : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
            toggleBtn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
        });
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            hideError();
            var usuario = document.getElementById('username').value.trim();
            var contrasena = passwordInput.value;
            if (!usuario || !contrasena) {
                showError('Complet\u00e1 usuario y contrase\u00f1a');
                return;
            }
            try {
                var res = await fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ usuario: usuario, contrasena: contrasena }),
                });
                var text = await res.text();
                if (!res.ok) {
                    try {
                        var err = JSON.parse(text);
                        showError(err.error || 'Error al iniciar sesi\u00f3n');
                    } catch (e2) {
                        showError('Error del servidor (' + res.status + ')');
                    }
                    return;
                }
                var data = JSON.parse(text);
                sessionStorage.setItem('usuario', JSON.stringify(data));
                window.location.href = '/';
            } catch (err) {
                showError('Error de conexi\u00f3n. Verific\u00e1 tu internet.');
            }
        });
    </script>
</body>
</html>
